# ========================================
# GCP Vertex AI 설정
# ========================================
# GCP 서비스 계정 키 파일(.json)의 로컬 절대 경로를 입력하세요.
# [보안 주의] 실제 .json 키 파일은 보안상 절대 Git에 커밋하지 마세요!
GOOGLE_APPLICATION_CREDENTIALS=./path/to/your/service-account-key.json
GCP_PROJECT_ID=glaw-project
GCP_LOCATION=us-central1
GCP_MODEL_NAME=gemini-2.5-flash-lite

# ========================================
# CORS 설정
# ========================================
# 프론트엔드가 브라우저에서 API를 직접 호출할 때 허용할 Origin 목록
# 쉼표(,)로 구분하여 입력합니다.
# 예: https://app.example.com,https://www.example.com
CORS_ALLOW_ORIGINS=http://localhost:3000

# ========================================
# 데이터베이스 설정
# ========================================
# 로컬 개발 시 SSH 터널링을 사용하므로 127.0.0.1로 설정합니다.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=aidb
DB_USER=admin
# 비밀번호는 보안상 공유하지 않습니다. 팀장에게 문의하세요.
DB_PASSWORD=YOUR_PASSWORD_HERE

# ========================================
# Redis 설정 (대화 기록 세션 저장소)
# ========================================
# 로컬 개발: SSH 터널링으로 서버의 Redis에 접속 (DB 터널링과 동일 방식)
# 운영 환경: FastAPI VM에 Redis 설치 후 localhost:6379
# Redis 연결 실패 시 자동으로 인메모리 fallback 모드로 전환됩니다.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_SESSION_TTL=1800